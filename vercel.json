{
    "version": 2,
    "builds": [
        {
            "src": "back-end/package.json",
            "use": "@vercel/node",
            "config": {
                "buildCommand": "cd back-end && npm install && npm run build"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "back-end/dist/main.js",
            "methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH"
            ]
        }
    ]
}